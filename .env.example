# Required: generate a unique random secret with at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# PostgreSQL: either set DATABASE_URL or the SQL_* fields below.
DATABASE_URL=
SQL_HOST=localhost
SQL_USER=postgres
SQL_PASSWORD=replace_with_local_database_password
SQL_DB_NAME=wonderstay
SQL_SSL=false
SQL_SSL_REJECT_UNAUTHORIZED=true

# For a separate frontend origin, set a comma-separated allowlist.
CORS_ORIGINS=http://localhost:5173

# Frontend build-time settings.
# Leave VITE_API_BASE_URL unset for same-origin deployment (/api).
VITE_API_BASE_URL=http://localhost:3000/api
# Optional. Restrict the browser key to your deployed referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=replace_with_a_referrer_restricted_maps_key

# Optional integration key; do not expose server-only secrets with a VITE_ prefix.
GEMINI_API_KEY=replace_with_gemini_key_if_used
